# Public URLs (filled by `bun run env:sync` for local)
SUPABASE_API_URL=http://127.0.0.1:54421
# Browser-exposed copies (anon key is public by design; used for read-only
# access to the moontotems metadata table, enforced by RLS).
VITE_SUPABASE_URL=http://127.0.0.1:54421
VITE_SUPABASE_ANON_KEY=
SUPABASE_GRAPHQL_URL=http://127.0.0.1:54421/graphql/v1
SUPABASE_STORAGE_URL=http://127.0.0.1:54421/storage/v1/s3
SUPABASE_STUDIO_URL=http://127.0.0.1:54423
INBUCKET_URL=http://127.0.0.1:54424
SUPABASE_ANON_KEY=

# Private configuration
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres
SUPABASE_JWT_SECRET=
# Populate from `supabase status` output after running `bun run dev:db`.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_REGION=local

# Web3 / MoonTotems
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_cloud_project_id
VITE_TARGET_CHAIN_ID=31337
VITE_LOCALHOST_RPC_URL=http://127.0.0.1:8545
# Optional mainnet / public RPC
VITE_RPC_URL=

# Chatbot (server-only — never prefix with VITE_)
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Reference / later (from old CRA sample.env + constants.js)
# Not wired by default — kept so we can restore if needed.
# ---------------------------------------------------------------------------
# REACT_APP_PROVIDER=https://rinkeby.infura.io/v3/xxxxx
# REACT_APP_OPENAI_API_KEY=
# REACT_APP_OTHER_VAR=myVar
# INFURA_ID=   # prefer VITE_RPC_URL / MAINNET_RPC_URL instead
# ETHERSCAN_KEY=
# BLOCKNATIVE_DAPPID=
