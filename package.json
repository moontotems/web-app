{
	"name": "moontotems",
	"description": "MoonTotems NFT monorepo: web app, smart contracts, and supporting packages",
	"version": "0.1.0",
	"authors": [
		"S\u00f6ren Steiger <ssteiger@users.noreply.github.com>"
	],
	"private": true,
	"packageManager": "bun@1.2.23",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/ssteiger/moontotems"
	},
	"scripts": {
		"build": "turbo run build",
		"dev": "bun run env:check && bun run dev:db && bun run env:sync && bun run db:migrate && turbo run dev --parallel",
		"dev:db": "cd apps/supabase && npx supabase start",
		"db:migrate": "cd apps/supabase && npx supabase migration up --local",
		"db:reset": "cd apps/supabase && npx supabase db reset",
		"db:seed:moontotems": "cd packages/db-drizzle && npx tsx scripts/import-moontotems.ts",
		"storage:upload": "cd apps/supabase && bun run scripts/upload-assets.ts",
		"dev:my-app": "turbo run dev --filter=@moontotems/my-app",
		"dev:web": "turbo run dev --filter=@moontotems/web",
		"chain": "bun run --filter=@moontotems/hardhat chain",
		"compile": "bun run --filter=@moontotems/hardhat compile",
		"deploy": "bun run --filter=@moontotems/hardhat deploy",
		"typecheck": "turbo run typecheck",
		"lint": "turbo run biome:check",
		"format": "turbo run biome:format",
		"env:check": "node scripts.js env:check",
		"env:sync": "node scripts.js env:sync"
	},
	"devDependencies": {
		"@rollup/rollup-darwin-arm64": "4.60.4",
		"@rollup/rollup-darwin-x64": "4.60.4",
		"supabase": "^2.20.5",
		"turbo": "^2.4.4"
	}
}
