{
  "name": "@moontotems/hardhat",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "chain": "hardhat node --network hardhat --no-deploy",
    "compile": "hardhat compile",
    "deploy": "hardhat deploy --network localhost && node scripts/export-contracts.js",
    "deploy:hardhat": "hardhat deploy --network hardhat && node scripts/export-contracts.js",
    "deploy:mainnet": "hardhat deploy --network mainnet && node scripts/export-contracts.js",
    "test": "hardhat test --network hardhat",
    "watch": "node scripts/watch.js",
    "accounts": "hardhat accounts",
    "balance": "hardhat balance",
    "send": "hardhat send",
    "generate": "hardhat generate",
    "account": "hardhat account",
    "export-contracts": "node scripts/export-contracts.js",
    "etherscan-verify": "hardhat etherscan-verify"
  },
  "dependencies": {
    "@nomiclabs/hardhat-ethers": "npm:hardhat-deploy-ethers@0.3.0-beta.13",
    "@nomiclabs/hardhat-waffle": "^2.0.0",
    "chai": "^4.2.0",
    "chalk": "^4.1.0",
    "dotenv": "^16.4.5",
    "ethereum-waffle": "^3.1.1",
    "ethers": "5.7.2",
    "hardhat": "2.19.5",
    "hardhat-deploy": "0.11.45",
    "node-watch": "^0.7.0",
    "qrcode-terminal": "^0.12.0"
  }
}
